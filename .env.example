# Frontend local development
# In Zeabur Docker runtime use API_BASE_URL instead; do not expose secrets here.
VITE_API_BASE_URL=/api
VITE_BACKEND_PORT=3000
VITE_DEV_SERVER_PORT=5173
VITE_API_TIMEOUT=10000
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true

# Optional frontend display and feature settings
VITE_DEFAULT_AVATAR=/placeholder.svg?height=40&width=40
VITE_PLACEHOLDER_IMAGE=/placeholder.jpg
VITE_LOGO_PATH=/placeholder-logo.svg
VITE_DEFAULT_COMMUNITY=本地社区
VITE_DEFAULT_REGION=广东·清远
VITE_LOCATION_API_ENABLED=false
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100
VITE_POSTS_PER_PAGE=20
VITE_COURSES_PER_PAGE=12
VITE_MAX_FILE_SIZE=10485760
VITE_ENABLE_MOCK=false
VITE_DEBUG=false
VITE_SHOW_METRICS=false
