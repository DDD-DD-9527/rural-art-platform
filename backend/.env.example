# Local development defaults. Copy this file to backend/.env locally.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/rural-art-platform
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Browser origins. In Zeabur set this to the frontend public URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true

# Uploads. In Zeabur mount a persistent volume at /app/uploads.
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/avi,video/quicktime,video/x-ms-wmv,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Optional database and request tuning
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT=5000
DB_SOCKET_TIMEOUT=45000
DB_CONNECT_TIMEOUT=10000
DB_MAX_IDLE_TIME=30000
TRUST_PROXY=true
REQUEST_SIZE_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_DEV_MAX=1000
RATE_LIMIT_PROD_MAX=100

# Optional AI integrations. Leave blank to disable the corresponding service.
GZHU_AGENT_API_URL=https://api.gzhu.edu.cn/agent
GZHU_AGENT_KEY=
GZHU_AGENT_TIMEOUT=30000
COZE_API_URL=https://api.coze.cn
COZE_API_KEY=
COZE_TIMEOUT=60000
COZE_IMAGE_ENHANCE_BOT_ID=
COZE_STYLE_TRANSFER_BOT_ID=
COZE_PATTERN_GENERATE_BOT_ID=
COZE_SMART_REPAIR_BOT_ID=
COZE_WORKFLOW_RUN_URL=
COZE_WORKFLOW_TOKEN=
COZE_WORKFLOW_TIMEOUT=300000

# Optional email and cache integrations
REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com
FROM_NAME=乡艺未来平台
