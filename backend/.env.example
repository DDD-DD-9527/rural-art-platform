# Local development defaults. Set NODE_ENV=production in Zeabur.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/rural-art-platform
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Browser access. Use the deployed frontend origin; separate multiple origins with commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Uploads. Mount a Zeabur persistent volume at /app/uploads when uploads must survive redeploys.
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=5

# Optional AI integrations
GZHU_AGENT_API_URL=https://api.gzhu.edu.cn/agent
GZHU_AGENT_KEY=
GZHU_AGENT_TIMEOUT=30000
COZE_API_URL=https://api.coze.cn
COZE_API_KEY=
COZE_TIMEOUT=60000
COZE_IMAGE_ENHANCE_BOT_ID=
COZE_STYLE_TRANSFER_BOT_ID=
COZE_PATTERN_GENERATE_BOT_ID=
COZE_SMART_REPAIR_BOT_ID=
COZE_WORKFLOW_RUN_URL=
COZE_WORKFLOW_TOKEN=
COZE_WORKFLOW_TIMEOUT=300000

# Optional tuning
TRUST_PROXY=true
REQUEST_SIZE_LIMIT=2mb
